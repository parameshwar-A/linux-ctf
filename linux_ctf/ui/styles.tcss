/* Linux CTF - Terminal User Interface Theme */

Screen {
    background: #0d1117;
    color: #c9d1d9;
    layout: vertical;
}

Header {
    background: #161b22;
    color: #58a6ff;
    dock: top;
    height: 3;
    border-bottom: solid #30363d;
}

Footer {
    background: #161b22;
    color: #8b949e;
    dock: bottom;
    height: 1;
}

#main-container {
    layout: horizontal;
    height: 1fr;
    width: 100%;
}

/* Sidebar */
#sidebar {
    width: 28;
    background: #161b22;
    border-right: solid #30363d;
    height: 100%;
    padding: 1;
}

#sidebar-title {
    text-align: center;
    text-style: bold;
    color: #58a6ff;
    margin-bottom: 1;
}

#rooms-list {
    background: #0d1117;
    border: solid #21262d;
    height: 1fr;
}

RoomListItem {
    height: 3;
    padding: 0 1;
    border-bottom: solid #21262d;
    background: #0d1117;
}

RoomListItem:hover {
    background: #1f242c;
}

RoomListItem.-selected {
    background: #1f2937;
    border-left: double #58a6ff;
}

RoomListItem Horizontal {
    height: 1;
    align-vertical: middle;
}

/* Main Content Area */
#content {
    width: 1fr;
    height: 100%;
    padding: 1 2;
    overflow-y: auto;
}

#room-header {
    height: auto;
    background: #161b22;
    border: solid #30363d;
    padding: 0 1;
    margin-bottom: 1;
}

#room-title {
    text-style: bold;
    color: #58a6ff;
    text-align: left;
}

#room-meta {
    color: #8b949e;
}

/* Toolbar: Single compact 1-line row without excess padding */
#toolbar {
    layout: grid;
    grid-size: 5;
    grid-columns: 1fr 1fr 1fr 1fr 1fr;
    grid-gutter: 0 1;
    height: 1;
    margin-bottom: 1;
    width: 100%;
}

#toolbar Button {
    height: 1;
    min-height: 1;
    border: none;
    padding: 0;
    margin: 0;
    text-style: bold;
}

#btn-pull, #btn-build {
    background: #1f6feb;
    color: #ffffff;
}

#btn-pull:hover, #btn-build:hover {
    background: #388bfd;
}

#btn-enter {
    background: #238636;
    color: #ffffff;
}

#btn-enter:hover {
    background: #2ea043;
}

#btn-clean {
    background: #da3633;
    color: #ffffff;
}

#btn-clean:hover {
    background: #f85149;
}

#btn-hint {
    background: #8957e5;
    color: #ffffff;
}

#btn-hint:hover {
    background: #a371f7;
}

#btn-submit {
    background: #d29922;
    color: #0d1117;
}

#btn-submit:hover {
    background: #e3b341;
}

/* Card Sections */
.info-card {
    height: auto;
    background: #161b22;
    border: solid #30363d;
    padding: 0 1;
    margin-bottom: 1;
}

.card-title {
    text-style: bold;
    color: #7ee787;
    margin-top: 0;
    margin-bottom: 0;
}

#commands-chips {
    color: #ffa657;
    text-style: bold;
    height: auto;
    margin-top: 1;
}

#mission-text {
    color: #f0f6fc;
    height: auto;
    margin-top: 1;
}

#hint-box {
    background: #0d1117;
    border: dashed #8b949e;
    padding: 1;
    color: #8b949e;
    margin-top: 1;
    margin-bottom: 1;
    height: auto;
}

#hint-box.revealed {
    border: solid #d29922;
    background: #1f1b13;
    color: #ffd33d;
    text-style: bold;
}

/* Badges */
.badge-ready {
    color: #3fb950;
    text-style: bold;
}

.badge-unbuilt {
    color: #8b949e;
    text-style: bold;
}

.badge-running {
    color: #58a6ff;
    text-style: bold;
}

/* Modal Screens */
SubmitModal, ConfirmCleanModal {
    align: center middle;
    background: rgba(13, 17, 23, 0.85);
}

#modal-dialog {
    width: 65;
    height: auto;
    background: #161b22;
    border: solid #58a6ff;
    padding: 1 2;
}

#modal-title {
    text-align: center;
    text-style: bold;
    color: #58a6ff;
    margin-bottom: 1;
}

#modal-msg {
    color: #c9d1d9;
    margin-bottom: 1;
    text-align: center;
}

#flag-input {
    margin-bottom: 1;
    border: solid #30363d;
    background: #0d1117;
    color: #58a6ff;
}

#modal-buttons {
    layout: horizontal;
    align-horizontal: center;
    height: 1;
    margin-top: 1;
}

#modal-buttons Button {
    margin: 0 1;
    min-width: 14;
    height: 1;
    min-height: 1;
    border: none;
    padding: 0;
}

#feedback-label {
    text-align: center;
    margin-top: 1;
    text-style: bold;
}

.success-text {
    color: #3fb950;
}

.error-text {
    color: #f85149;
}
